<%- include("../partials/header") %>

<div class="page-header">
  <div class="page-header-text">
    <h1>Circlix Collection Centre Network</h1>
    <p class="muted">Closing the Loop on E-Waste — Manage certified physical intake hubs and regional e-waste consolidation facilities.</p>
  </div>
  <div>
    <a class="btn secondary small" href="/admin/dashboard">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back to Analytics</span>
    </a>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: flex-start;">
  <div class="form-card">
    <div class="form-header">
      <h2 style="font-size: 1.25rem;">Add Collection Centre</h2>
      <p class="muted">Register a new intake or storage facility in your operational network.</p>
    </div>

    <form action="/admin/centres" method="POST">
      <div class="form-group">
        <label>Centre Name</label>
        <input type="text" name="name" placeholder="e.g. Green Recycling Hub" required>
      </div>

      <div class="form-group">
        <label>Operational Area / Zone</label>
        <input type="text" name="area" placeholder="e.g. Ghaziabad, Noida, Delhi" required>
      </div>

      <div class="form-group">
        <label>Physical Address</label>
        <textarea name="address" placeholder="Complete street address of the facility" required></textarea>
      </div>

      <div class="form-group">
        <label>
          <span>Contact Number / Helpline</span>
          <span class="hint">Optional</span>
        </label>
        <input type="text" name="contact" placeholder="e.g. 9876543210">
      </div>

      <button class="btn" type="submit" style="margin-top: 0.5rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add Collection Centre</span>
      </button>
    </form>
  </div>

  <div>
    <h2 class="section-title" style="margin-top: 0;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Active Centre Network (<%= centres.length %>)</span>
    </h2>

    <div class="table-card" style="margin-top: 0.5rem;">
      <% if (centres.length === 0) { %>
        <div class="empty-state" style="padding: 2.5rem 1rem;">
          <div class="empty-state-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>No Centres Registered</h3>
          <p>Use the form to add your first authorized regional collection centre.</p>
        </div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Centre Name</th>
              <th>Area</th>
              <th>Address</th>
              <th>Contact</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% centres.forEach(centre => { %>
              <tr>
                <td>
                  <strong><%= centre.name %></strong>
                </td>
                <td>
                  <span class="badge" style="background: #f1f5f9; color: #334155;"><%= centre.area %></span>
                </td>
                <td style="font-size: 0.82rem; max-width: 200px;">
                  <%= centre.address %>
                </td>
                <td>
                  <%= centre.contact || "-" %>
                </td>
                <td>
                  <form action="/admin/centres/<%= centre._id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this collection centre?');">
                    <button class="btn danger small" type="submit" title="Delete Centre">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <span>Delete</span>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>