<%- include("../partials/header") %>

<div class="page-header">
  <div class="page-header-text">
    <h1>Circlix Categories & Rates</h1>
    <p class="muted">Closing the Loop on E-Waste — Define accepted electronic scrap types and configure citizen reward rates per kilogram.</p>
  </div>
  <div>
    <a class="btn secondary small" href="/admin/dashboard">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back to Analytics</span>
    </a>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; align-items: flex-start;">
  <div class="form-card">
    <div class="form-header">
      <h2 style="font-size: 1.25rem;">Add E-Waste Category</h2>
      <p class="muted">Configure a new recyclable item type and its reward incentive.</p>
    </div>

    <form action="/admin/categories" method="POST">
      <div class="form-group">
        <label>Category Name</label>
        <input type="text" name="name" placeholder="e.g. Laptops, Mobiles, Monitors" required>
      </div>

      <div class="form-group">
        <label>
          <span>Reward Points per Kilogram (pts/kg)</span>
          <span class="hint">Citizen wallet incentive rate</span>
        </label>
        <input type="number" name="rewardPointsPerKg" min="0" placeholder="e.g. 50" required>
      </div>

      <button class="btn" type="submit" style="margin-top: 0.5rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add Category</span>
      </button>
    </form>
  </div>

  <div>
    <h2 class="section-title" style="margin-top: 0;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      <span>Category Catalogue (<%= categories.length %>)</span>
    </h2>

    <div class="table-card" style="margin-top: 0.5rem;">
      <% if (categories.length === 0) { %>
        <div class="empty-state" style="padding: 2.5rem 1rem;">
          <div class="empty-state-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/></svg>
          </div>
          <h3>No Categories Yet</h3>
          <p>Add electronic categories using the form to let citizens schedule pickups.</p>
        </div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Category Name</th>
              <th>Incentive Rate</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach(category => { %>
              <tr>
                <td>
                  <span class="badge badge-category"><%= category.name %></span>
                </td>
                <td>
                  <span class="badge-pts"><%= category.rewardPointsPerKg %> pts/kg</span>
                </td>
                <td>
                  <form action="/admin/categories/<%= category._id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this category?');">
                    <button class="btn danger small" type="submit" title="Delete Category">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <span>Delete</span>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>