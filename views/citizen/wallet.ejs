<%- include("../partials/header") %>

<div class="page-header">
  <div class="page-header-text">
    <h1>Circlix Reward Wallet</h1>
    <p class="muted">Closing the Loop on E-Waste — Earn points for every kilogram of responsibly recycled electronics and redeem for sustainable rewards.</p>
  </div>
</div>

<div class="wallet-balance-card">
  <div>
    <div class="wallet-title">Available Green Balance</div>
    <div class="wallet-points">
      <%= points %> <span>pts</span>
    </div>
    <div class="wallet-desc">
      Points are automatically credited to your wallet as soon as an assigned collection agent marks your e-waste as <strong>Recycled</strong>.
    </div>
  </div>
  <div class="wallet-icon-big">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/>
      <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
    </svg>
  </div>
</div>

<% if (error) { %>
  <div class="error">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span><%= error %></span>
  </div>
<% } %>

<h2 class="section-title">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
  <span>Redeem Reward Points</span>
</h2>

<div class="card-grid-2">
  <!-- 50 POINT REWARD -->
  <div class="reward-card">
    <div>
      <div class="reward-badge-cost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="m7 6 5 5"/></svg>
        <span>50 Points Required</span>
      </div>
      <h3>Eco Recycling Voucher</h3>
      <p style="margin: 0.5rem 0 1.25rem;">Redeem your points for a ₹250 discount voucher usable at verified eco-friendly partner stores.</p>
    </div>

    <form action="/citizen/wallet/redeem" method="POST">
      <input type="hidden" name="reward" value="voucher">
      <button class="btn" type="submit" style="width: 100%;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Redeem 50 Points</span>
      </button>
    </form>
  </div>

  <!-- 100 POINT REWARD -->
  <div class="reward-card">
    <div>
      <div class="reward-badge-cost" style="background: #fef3c7; border-color: #fde68a; color: #92400e;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="m7 6 5 5"/></svg>
        <span>100 Points Required</span>
      </div>
      <h3>Eco Recycling Kit</h3>
      <p style="margin: 0.5rem 0 1.25rem;">Receive a comprehensive green lifestyle kit containing organic cotton produce bags, bamboo cutlery, and seed pens.</p>
    </div>

    <form action="/citizen/wallet/redeem" method="POST">
      <input type="hidden" name="reward" value="kit">
      <button class="btn" type="submit" style="width: 100%;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Redeem 100 Points</span>
      </button>
    </form>
  </div>
</div>

<h2 class="section-title">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
  <span>Reward & Redemption History</span>
</h2>

<div class="table-card">
  <% if (history.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
      </div>
      <h3>No Reward Transactions Yet</h3>
      <p>Points are automatically credited when your pickup requests reach the <strong>Recycled</strong> status.</p>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Transaction Type</th>
          <th>Points</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach(item => { %>
          <tr>
            <td>
              <%= new Date(item.createdAt).toLocaleDateString() %>
            </td>
            <td>
              <% if (item.type === "Credit") { %>
                <span class="badge badge-credit">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
                  <span><%= item.type %></span>
                </span>
              <% } else { %>
                <span class="badge badge-deduction">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
                  <span><%= item.type %></span>
                </span>
              <% } %>
            </td>
            <td>
              <% if (item.points > 0) { %>
                <span style="color: #15803d; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif;">
                  +<%= item.points %> pts
                </span>
              <% } else { %>
                <span style="color: #b91c1c; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif;">
                  <%= item.points %> pts
                </span>
              <% } %>
            </td>
            <td>
              <%= item.description %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../partials/footer") %>