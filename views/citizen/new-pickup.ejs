<%- include("../partials/header") %>

<div style="max-width: 680px; margin: 1.5rem auto;">
  <div class="page-header" style="margin-bottom: 1.25rem;">
    <div class="page-header-text">
      <h1>Circlix E-Waste Pickup</h1>
      <p class="muted">Closing the Loop on E-Waste — Fill in your electronic waste details and preferred schedule for safe doorstep collection.</p>
    </div>
  </div>

  <div class="form-card">
    <% if (error) { %>
      <div class="error">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <div class="info-note">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <div>Reward points will be calculated as <code>Approximate Weight × Category Rate</code> once certified recycling is completed.</div>
    </div>

    <form action="/citizen/pickups" method="POST">
      <div class="form-section-divider">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
        <span>1. Electronic Waste Details</span>
      </div>

      <div class="form-group">
        <label>
          <span>E-Waste Category</span>
          <span class="hint">Select the category of items you want to dispose</span>
        </label>
        <select name="category" required>
          <option value="">Choose a category...</option>
          <% categories.forEach(category => { %>
            <option value="<%= category._id %>">
              <%= category.name %> — <%= category.rewardPointsPerKg %> pts/kg
            </option>
          <% }) %>
        </select>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label>
            <span>Item Quantity</span>
            <span class="hint">Number of pieces</span>
          </label>
          <input type="number" name="quantity" min="1" placeholder="e.g. 2" required>
        </div>

        <div class="form-group">
          <label>
            <span>Approximate Weight (kg)</span>
            <span class="hint">Total estimated kg</span>
          </label>
          <input type="number" name="approximateWeight" min="0.1" step="0.1" placeholder="e.g. 1.5" required>
        </div>
      </div>

      <div class="form-section-divider">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>2. Location & Preferred Date</span>
      </div>

      <div class="form-group">
        <label>
          <span>Locality / Area</span>
          <span class="hint">City, Sector, or Neighborhood</span>
        </label>
        <input type="text" name="area" placeholder="e.g. Sector 62, Noida or Indirapuram" required>
      </div>

      <div class="form-group">
        <label>
          <span>Complete Pickup Address</span>
          <span class="hint">Flat/House no., building name, street landmark</span>
        </label>
        <textarea name="address" placeholder="Enter complete door-to-door address for collection agent" required></textarea>
      </div>

      <div class="form-group">
        <label>
          <span>Preferred Pickup Date</span>
          <span class="hint">Select date when someone will be available</span>
        </label>
        <input type="date" name="preferredDate" required>
      </div>

      <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.85rem; margin-top: 1rem;">
        <a class="btn secondary" href="/citizen/dashboard">Cancel</a>
        <button class="btn" type="submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          <span>Submit Pickup Request</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include("../partials/footer") %>